# Single-service address; dev also starts Vite on WEB_PORT.
ORCHMESH_HOST=127.0.0.1
ORCHMESH_PORT=8000
ORCHMESH_WEB_PORT=5173

# First-run administrator: login uses an email, password needs 12+ characters.
# Existing accounts/passwords are NEVER overwritten or promoted.
ORCHMESH_BOOTSTRAP_ADMIN_EMAIL=
ORCHMESH_BOOTSTRAP_ADMIN_PASSWORD=

# Runtime model for the administrator only: edit here and restart.
# Fill BASE_URL, API_KEY and ID together, or clear all three to disable.
# Owns model provider project-api and default model; other entries are preserved.
# BASE_URL is the provider's API base URL, e.g. https://api.example.com/v1.
# Keep the provider's required prefix (such as /v1); do not append /chat/completions
# or /responses. The model adapter appends the endpoint path for the selected protocol.
# Quote secrets containing # or spaces.
ORCHMESH_MODEL_BASE_URL=
# Optional: defaults to openai-completions (Chat Completions).
# For the Responses API, uncomment and set this to openai-responses.
# ORCHMESH_MODEL_API=openai-completions
ORCHMESH_MODEL_API_KEY=
ORCHMESH_MODEL_ID=

# Defaults: .data/ and apps/web/dist under this repository. Use absolute paths.
# ORCHMESH_DATA_DIR=/absolute/path/to/data
ORCHMESH_DSH_IMAGE=orchmesh-dsh:0.2.1-rc.3
# Maximum live user Hosts, including prewarming and idle instances.
ORCHMESH_MAX_ACTIVE_RUNS=4
ORCHMESH_RUN_TIMEOUT=1800
# Reuse each user runtime; reclaim only after this many idle seconds.
ORCHMESH_RUNTIME_IDLE_SECONDS=600

# Bearer JWT lifetime in minutes. Restart after changing this value.
ORCHMESH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application logs rotate at local midnight; retain this many daily archives.
ORCHMESH_LOG_LEVEL=INFO
ORCHMESH_LOG_RETENTION_DAYS=30

# Optional DSH reasoning capability mapping. Leave unset for provider defaults.
# Declare only levels your endpoint supports; values are the protocol spellings.
# DeepSeek-compatible endpoints require the thinking format to explicitly disable thinking.
# ORCHMESH_MODEL_REASONING_EFFORTS='{"off":null,"high":"high"}'
# ORCHMESH_MODEL_THINKING_FORMAT=deepseek
